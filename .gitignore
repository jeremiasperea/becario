# === Secretos y datos locales (NUNCA subir a un repositorio) ===
# Config generada por el asistente de primer arranque (token del bot, etc.)
.env
# Roster con tu cuenta del cluster (usuario + ruta de clave)
users.json
# Base SQLite (historial, jobs)
*.db
becario.db
# Estructuras atómicas generadas localmente
/structures/

# Claves SSH que pudieran quedar en el proyecto por error
*.pem
*.key
id_rsa
id_ed25519
id_*

# === Entornos y artefactos de Python ===
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# === Artefactos de descarga de Windows/WSL ===
# El sufijo real es ":Zone.Identifier" (dos puntos), no ".Zone.Identifier".
*Zone.Identifier

# === Artefactos generados ===
repomix-output.xml
