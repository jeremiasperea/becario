# Referencia de las variables disponibles.
#
# NO hace falta crear este archivo a mano: la primera vez que corras
# `python main.py`, un asistente te pide los datos y crea el `.env` por vos.
# Este .env.example queda solo como documentación. NUNCA commitees el .env real
# (ya está en .gitignore).
BECARIO_BOT_TOKEN=123456:AAH_tu_token_aca
BECARIO_SSH_HOST=cluster.ejemplo.edu.ar
BECARIO_SSH_PORT=22
BECARIO_USERS_FILE=users.json
BECARIO_OLLAMA_URL=http://localhost:11434
BECARIO_OLLAMA_MODEL=gemma4:12b
# Cuánto esperar (segundos) la respuesta del modelo. En máquinas sin GPU la
# primera inferencia tras un arranque frío puede tardar varios minutos.
BECARIO_OLLAMA_TIMEOUT=120
BECARIO_DB_PATH=becario.db
BECARIO_STRUCTURES_DIR=./structures
BECARIO_CONFIRM_TTL=600
BECARIO_MONITOR_INTERVAL=60

# El roster de personas (users.json) se administra aparte:
#   python scripts/manage_users.py add --telegram-id 111111111 \
#       --ssh-user jperez --ssh-key ~/.ssh/id_jperez --name "Juan Pérez"
